{
  "$defs": {
    "Band": {
      "description": "Composite score band.",
      "enum": [
        "strong",
        "good",
        "borderline",
        "weak",
        "not_a_match"
      ],
      "title": "Band",
      "type": "string"
    },
    "Bullet": {
      "description": "A single bullet of experience narrative.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span"
        }
      },
      "required": [
        "text"
      ],
      "title": "Bullet",
      "type": "object"
    },
    "CanonicalResume": {
      "description": "The canonical structured representation of a resume.",
