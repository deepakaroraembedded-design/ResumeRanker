        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "fatal": {
          "default": false,
          "title": "Fatal",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "code",
        "message"
      ],
