{
  "$defs": {
    "ExtractionMetadata": {
      "description": "Quality and method metadata for an extraction.",
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "chars_per_page": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chars Per Page"
        },
        "ocr_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Confidence"
        },
        "columns_detected": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns Detected"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "language_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language Confidence"
        },
        "quality": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        }
      },
      "required": [
        "method"
      ],
      "title": "ExtractionMetadata",
      "type": "object"
    },
    "TextBlock": {
      "description": "A contiguous block of extracted text with layout metadata.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "page": {
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "font_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size"
        },
        "colour": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colour"
        },
        "render_mode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Render Mode"
        }
      },
      "required": [
        "text",
        "page",
        "bbox"
      ],
      "title": "TextBlock",
      "type": "object"
    }
  },
  "description": "Normalised text extracted from a source document.",
  "properties": {
    "text": {
      "title": "Text",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ExtractionMetadata"
    },
    "blocks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TextBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "language_confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language Confidence"
    }
  },
  "required": [
    "text",
    "metadata"
  ],
  "title": "ExtractedText",
  "type": "object"
}
