    "documents_in": {
      "default": 0,
      "title": "Documents In",
      "type": "integer"
    },
    "documents_failed": {
      "default": 0,
      "title": "Documents Failed",
      "type": "integer"
    },
    "cache_hits": {
      "default": 0,
      "title": "Cache Hits",
      "type": "integer"
    },
    "llm_calls": {
      "default": 0,
      "title": "Llm Calls",
      "type": "integer"
    },
    "tokens_in": {
      "default": 0,
      "title": "Tokens In",
      "type": "integer"
    },
    "tokens_out": {
      "default": 0,
      "title": "Tokens Out",
      "type": "integer"
    },
    "retries": {
      "default": 0,
      "title": "Retries",
      "type": "integer"
    },
    "timings": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timings",
      "type": "object"
